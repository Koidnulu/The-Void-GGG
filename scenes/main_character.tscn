[sub_resource type="GDScript" id="GDScript_0ltrl"]
script/source = "extends CharacterBody2D


const SPEED = 100.0
const JUMP_VELOCITY = -400.0
const ACCEL = 20;
const DASH_SPEED = 200
@onready var character: AnimatedSprite2D = $flipping/AnimatedSprite2D
@onready var coyote_timer: Timer = $\"coyote timer\"
@onready var dash_timer: Timer = $\"dash timer\"
@onready var flipping: Node2D = $flipping
@onready var player_attacking: Area2D = $flipping/player_attacking
@onready var attack_timer: Timer = $\"attack timer\"
# group name is camera
@onready var camera: Camera2D = get_tree().get_first_node_in_group(\"camera\")
@onready var sword: AudioStreamPlayer2D = $sword
@onready var jump: AudioStreamPlayer2D = $jump
@onready var detecting_tilemaps: Area2D = $\"detecting tilemaps\"


var airbone : bool = false
var dashing : bool = false
var can_dash : bool = true
var attacking: bool = false
var just_teleported : bool = false
var dmg : int = 0

func _ready() -> void:
	InteractionManager.dialogue_layout(self) 

# time of dashing
func _on_dash_timer_timeout() -> void:
	dashing = false 
	can_dash = true

func enemy_flash():
	if get_tree().current_scene.name != \"battle eyery\":
		return
		# the one detecting if the player attacked the enemy (if its overlapping)
	var overlapping_areas = player_attacking.get_overlapping_areas()
		
	for area in overlapping_areas:
		if area != null:
			if area.is_in_group(\"hurtbox\"):
				var enemy = area.owner
				if enemy != null:
					enemy.get_node(\"flipping/AnimatedSprite2D\").modulate = Color(10, 10, 10, 1)
					await get_tree().create_timer(0.2).timeout
					if is_instance_valid(enemy):
						enemy.take_dmg(dmg)
						camera.trigger_shake()
						enemy.get_node(\"flipping/AnimatedSprite2D\").modulate = Color.WHITE

func _input(event):
	if Input.is_action_just_pressed(\"attack1\") and not attacking and attack_timer.is_stopped():
		attack_1()
	elif Input.is_action_just_pressed(\"attack2\") and not attacking and attack_timer.is_stopped():
		attack_2()

func attack_1():
	attacking = true;
	dmg = 10
	character.play(\"attack 1\")
	sword.play()
	enemy_flash()
	await character.animation_finished
	attacking = false

func attack_2():
	attacking = true;
	dmg = 20
	character.play(\"attack 2\")
	sword.play()
	await get_tree().create_timer(0.5).timeout
	sword.play()
	enemy_flash()
	await character.animation_finished
	attacking = false
"

