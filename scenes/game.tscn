[sub_resource type="GDScript" id="GDScript_lbhrr"]
script/source = "extends Node2D

# first screen loaded
@onready var eyery = $eyery
@onready var main_character: CharacterBody2D = $main_character
var intro_played = false;

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	await Dialogic.start(\"tutorial\");
	await Dialogic.timeline_ended
	Dialogic.signal_event.connect(_on_dialogic_signal)
	# use eyere_intro rather than eyere_intro() because need a calleable function
	# (not yet called) instead of letting it execute immediately
	eyery.player_here.connect(eyery_intro)

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	if Dialogic.VAR.get_variable(\"eyery_lunch\") == true and intro_played:
		eyery.player_here.connect(func(): Dialogic.start(\"found eyery lunch\"), Object.CONNECT_ONE_SHOT)
		Dialogic.VAR.set_variable(\"eyery_lunch\", false)
	
func eyery_intro():
	eyery.player_here.disconnect(eyery_intro)
	var layout = Dialogic.Styles.load_style(\"res://styles/text_bubble.tres\") 
	layout.register_character(load(\"res://characters for dialogic/eyere.dch\"), eyery) 
	layout.register_character(load(\"res://characters for dialogic/protag.dch\"), $main_character)
	await eyery.intro_animation()
	Dialogic.start(\"eyere introduction\")
	await Dialogic.timeline_ended
	intro_played = true;
	
# if dialogic emits a signal
func _on_dialogic_signal(argument:String):
	if argument == \"running eyery\":
		Dialogic.paused = true;
		await eyery.intro_animation()
		await eyery.player_here 
		Dialogic.paused = false;
"

