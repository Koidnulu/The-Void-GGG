[sub_resource type="GDScript" id="GDScript_7qo1e"]
script/source = "extends CharacterBody2D

const SPEED = 300.0
const JUMP_VELOCITY = -400.0
signal player_here;
var health = 100

@onready var character: AnimatedSprite2D = $AnimatedSprite2D
@onready var state_machine: StateMachine = $StateMachine
@onready var eyery_hitbox: Area2D = $eyery_hitbox

func _physics_process(delta: float) -> void:
	if not is_on_floor():
		velocity.y += ProjectSettings.get_setting(\"physics/2d/default_gravity\") * delta
	var lost_health := 0
	if get_tree().current_scene.name == \"battle eyery\":
		if Input.is_action_just_pressed(\"attack1\"):
			lost_health = 10
		elif Input.is_action_just_pressed(\"attack2\"):
			lost_health = 20
	for body in eyery_hitbox.get_overlapping_bodies():
		if body.name == \"main_character\":
			health -= lost_health
			print(health)
	move_and_slide()


func _on_area_2d_body_entered(body: Node2D) -> void:
	if body.name == \"main_character\":
		player_here.emit()

func intro_animation():
	character.play(\"roll\");
	await character.animation_finished;
	global_position += Vector2(80, 0)
	state_machine.change_state(\"idle_eyery\") 
	
"

